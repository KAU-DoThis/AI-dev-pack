# 복사해서 .env 로 쓰기 (.env 는 깃에 안 올라감). 칸 설명은 docs/model-worker.md 4절·7절.
# AWS 키는 여기 넣지 말고 aws configure --profile 로 등록.
# 이 PC 전용 키 프로필 (재혁 PC = fintris-jeff, 승현 PC = fintris-slm)
AWS_PROFILE=fintris-jeff
AWS_REGION=ap-northeast-2

# 통합 워커 (python -m sqs_bridge): 이 PC에서 켤 일만 true
# 재혁 PC: JEFF_ENABLED=true SLM_ENABLED=false / 승현 PC: JEFF_ENABLED=false SLM_ENABLED=true
JEFF_ENABLED=true
SLM_ENABLED=false

# Jeff
# (JEFF_ENABLED=true면 필수)
JEFF_REQUESTS_URL=https://sqs.ap-northeast-2.amazonaws.com/<계정번호>/fintris-dev-jeff-requests
JEFF_URL=http://127.0.0.1:8765
# jeff-serve에서 쓸 모델 이름. 비우면 jeff-serve 기본 모델
JEFF_MODEL=
# Jeff에 같이 보낼 선택지(slm·ask)·지시문 파일. 비우면 요청에 options 가 꼭 있어야 함
JEFF_PROMPT_FILE=
JEFF_TIMEOUT=30

# sLM. 프롬프트·주소·키는 서버가 아니라 여기에만
# (SLM_ENABLED=true면 필수)
SLM_REQUESTS_URL=https://sqs.ap-northeast-2.amazonaws.com/<계정번호>/fintris-dev-slm-requests
# (필수) OpenAI 호환 주소, /v1 까지만 (뒤 /chat/completions 는 워커가 붙임). 예: http://127.0.0.1:8000/v1
# 수업 서버엔 실제 거래를 보내지 말 것
SLM_URL=
# (필수) vLLM /v1/models 응답의 id 그대로
SLM_MODEL=
# vLLM 을 --api-key 로 띄웠을 때만. 아니면 비움
SLM_API_KEY=
# v1·v2·v3 (sqs_bridge/slm.py PROMPTS)
SLM_PROMPT=v3
SLM_TIMEOUT=30

[
  {
    "name": "plan_create",
    "description": "Optionally create the current task's first plan. Does not execute work. Use stable item IDs; status defaults to pending, arrays to [], status_note to ''. Completion is your assessment, not independent verification; link evidence when available.",
    "parameters": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "item_id": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "enum": [
                  "pending",
                  "in_progress",
                  "completed",
                  "blocked",
                  "failed"
                ]
              },
              "depends_on": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "source_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "status_note": {
                "type": "string"
              }
            },
            "required": [
              "item_id",
              "description"
            ],
            "additionalProperties": false
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "description": "Why this change is needed, including any rework or invalidated result."
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Evidence: message:<index>, tool:<call_id>, memo:<id>, artifact:<id>, or external refs."
        }
      },
      "required": [
        "items",
        "reason"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "plan_read",
    "description": "Read the current plan (null before creation), or a retained historical revision.",
    "parameters": {
      "type": "object",
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "plan_update",
    "description": "Patch existing item progress, description, evidence or status_note. Omitted fields are preserved; supplied arrays replace that field. Explain reopening completed work in reason. Use plan_revise for composition/dependency/approach changes. No action runs automatically.",
    "parameters": {
      "type": "object",
      "properties": {
        "updates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "item_id": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "enum": [
                  "pending",
                  "in_progress",
                  "completed",
                  "blocked",
                  "failed"
                ]
              },
              "source_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "status_note": {
                "type": "string"
              }
            },
            "required": [
              "item_id"
            ],
            "additionalProperties": false
          }
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 1,
          "description": "The current revision read from the plan; stale changes are rejected."
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "description": "Why this change is needed, including any rework or invalidated result."
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Evidence: message:<index>, tool:<call_id>, memo:<id>, artifact:<id>, or external refs."
        }
      },
      "required": [
        "updates",
        "expected_revision",
        "reason"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "plan_revise",
    "description": "Replace the ordered item list, preserving omitted fields of retained IDs (including completed results). An item_id-only entry keeps that item unchanged. Absent IDs are excluded but remain in history. New/replacement work needs a new ID and description; excluded IDs cannot be reused. Explicitly reset status for rework and explain why. No tools run or files roll back.",
    "parameters": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "item_id": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "enum": [
                  "pending",
                  "in_progress",
                  "completed",
                  "blocked",
                  "failed"
                ]
              },
              "depends_on": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "source_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "status_note": {
                "type": "string"
              }
            },
            "required": [
              "item_id"
            ],
            "additionalProperties": false
          }
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 1,
          "description": "The current revision read from the plan; stale changes are rejected."
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "description": "Why this change is needed, including any rework or invalidated result."
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Evidence: message:<index>, tool:<call_id>, memo:<id>, artifact:<id>, or external refs."
        }
      },
      "required": [
        "items",
        "expected_revision",
        "reason"
      ],
      "additionalProperties": false
    }
  }
]
